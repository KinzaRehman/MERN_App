
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Pinboard</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>

<div class="container">

    <!-- PROFILE SECTION -->
    <div class="page-header">
        <h1>My Pinboard</h1>

        <p>Logged in as: <%= user.local.email %></p>

        <form action="/logout" method="POST">
            <button type="submit">Logout</button>
        </form>
    </div>

    <!-- ADD OR EDIT A PIN -->
<section class="add-pin">
    <h2 id="form-title">Add a Pin</h2>

    <form id="pin-form" action="/pins" method="POST">

        <label for="imageUrl">Photo URL</label>
        <input type="url" id="imageUrl" name="imageUrl" required>

        <label for="category">Category</label>
        <select name="category" id="category" required>
            <option value="">Select a category</option>
            <option value="Fashion">Fashion</option>
            <option value="Home Decor">Home Decor</option>
            <option value="Food">Food</option>
            <option value="Beauty">Beauty</option>
            <option value="Other">Other</option>
        </select>

        <label for="itemName">Item Name</label>
        <input type="text" id="itemName" name="itemName" required>

        <label for="color">Item Color</label>
        <input type="text" id="color" name="color" required>

        <label for="tags">Tags</label>
        <input type="text" id="tags" name="tags">

        <button type="submit" id="save-button">Save Pin</button>
        <button type="button" id="cancel-button" hidden>Cancel Edit</button>

    </form>
</section>


    <!-- DISPLAY SAVED PINS -->
    <section class="pins-section">
        <h2>My Pins</h2>

        <% if (pins.length === 0) { %>
            <p>You haven't saved any pins yet.</p>
        <% } %>

        <div class="pins">

            <% for (var i = 0; i < pins.length; i++) { %>

                <div class="pin">

                    <img src="<%= pins[i].imageUrl %>"
                         alt="Saved pin">

                    <h3><%= pins[i].itemName %></h3>

                    <p>Category: <%= pins[i].category %></p>
                    <p>Color: <%= pins[i].color %></p>

                    <!-- EDIT PIN -->
                    <button class="edit-button"
                    data-id="<%= pins[i]._id %>"
                    data-name="<%= pins[i].itemName %>"
                    data-category="<%= pins[i].category %>"
                    data-color="<%= pins[i].color %>"
                    data-image="<%= pins[i].imageUrl %>"
                    data-tags="<%= (pins[i].tags || []).join(', ') %>">Edit</button>

                    <!-- DELETE PIN -->
                    <button class="delete-button" data-id="<%= pins[i]._id %>">Delete </button>
                </div>

            <% } %>

        </div>
    </section>

</div>

<script src="/main.js"></script>

</body>
</html>

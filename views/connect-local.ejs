
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Connect Account | Pinboard</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>

    <header>
        <h1>Pinboard</h1>
        <nav>
            <a href="/profile">My Pins</a>
        </nav>
    </header>

    <div class="auth-container">

        <h2>Add Local Account</h2>
        <p>Connect an email and password to your account.</p>

        <!-- DISPLAY ERRORS -->
        <% if (message.length > 0) { %>
            <div class="alert-danger">
                <%= message %>
            </div>
        <% } %>

        <!-- CONNECT LOCAL ACCOUNT FORM -->
        <form action="/connect/local" method="POST">

            <div class="form-group">
                <label for="email">Email</label>
                <input type="email" id="email" name="email" placeholder="Enter your email" required>
            </div>

            <div class="form-group">
                <label for="password">Password</label>
                <input type="password" id="password" name="password" placeholder="Enter your password" required>
            </div>

            <button type="submit" class="auth-button"> Add Local Account</button>
        </form>

        <div class="auth-links">
            <p><a href="/profile">Back to My Pins</a></p>
        </div>

    </div>

</body>
</html>
